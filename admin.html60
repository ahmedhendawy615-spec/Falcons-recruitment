<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recruitment Admin — SCOPS</title>
<meta name="theme-color" content="#1B0B2E">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<meta name="apple-mobile-web-app-title" content="SCOPS">
<meta name="robots" content="noindex,nofollow">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap');
:root{
  --navy-900:#1B0B2E;--navy-700:#4B1D73;--steel-600:#7A3FA6;--teal-500:#9830A0;--teal-400:#B57BE0;--sky-300:#B565E8;--sky-100:#EBDDF7;
  --ink:#EBDDF7;--paper:#1B0B2E;--card:#2E1650;--accent:#B565E8;--accent-dim:#44226B;--gold:#F8B048;--muted:#B9A0D6;--line:#52307F;--danger:#FF6B5E;--ok:#5FD4A0;--warn:#F8B048;--input:#3A1D60;
}
*{box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;background:#1B0B2E;}
body{margin:0;background:linear-gradient(160deg,var(--navy-900) 0%,#240F3D 55%,var(--navy-700) 100%);background-attachment:fixed;color:var(--ink);font-family:'Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh;}
.wrap{max-width:880px;margin:0 auto;padding:28px 16px 80px;}
.wrap.wide{max-width:1240px;}
header.top{display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--line);padding-bottom:16px;margin-bottom:22px;gap:12px;flex-wrap:wrap;}
.brand-mark{display:flex;align-items:center;gap:12px;}
.scops-badge{width:46px;height:46px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;box-shadow:0 0 0 3px rgba(181,101,232,.15);}
.scops-badge img{width:100%;height:100%;object-fit:contain;padding:4px;}
h1{font-family:'Space Grotesk',Arial,sans-serif;font-weight:700;font-size:26px;text-transform:uppercase;letter-spacing:-.01em;margin:0;line-height:1.05;}
h2{font-family:'Space Grotesk',Arial,sans-serif;font-size:14px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 14px;font-weight:700;}
h3{font-family:'Space Grotesk',Arial,sans-serif;font-size:16px;margin:0 0 8px;}
.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin:0 0 2px;}
.panel{background:var(--card);border:1px solid var(--line);border-radius:2px;padding:20px;margin-bottom:20px;position:relative;}
.hint{color:var(--muted);font-size:12px;line-height:1.5;}
label,.lbl{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:600;}
.field{display:flex;flex-direction:column;gap:6px;margin-bottom:16px;}
.field .desc{font-size:12px;color:var(--muted);text-transform:none;letter-spacing:0;font-weight:400;}
.req{color:var(--danger);margin-left:3px;}
input,select,textarea{font-family:inherit;font-size:14px;padding:10px;border:1px solid var(--line);border-radius:2px;background:var(--input);color:var(--ink);width:100%;}
textarea{min-height:90px;resize:vertical;}
input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid var(--accent);outline-offset:1px;}
input[type=checkbox],input[type=radio]{width:auto;accent-color:var(--accent);}
.opt{display:flex;align-items:center;gap:10px;padding:9px 10px;border:1px solid var(--line);background:var(--input);border-radius:2px;margin-bottom:6px;font-size:14px;color:var(--ink);text-transform:none;letter-spacing:0;font-weight:400;cursor:pointer;}
.opt:hover{border-color:var(--accent);}
.field.invalid input,.field.invalid select,.field.invalid textarea,.field.invalid .opt{border-color:var(--danger);}
.err{color:var(--danger);font-size:12px;display:none;}
.field.invalid .err{display:block;}
.btn{font-family:inherit;font-size:13px;font-weight:600;padding:10px 16px;border:1px solid var(--accent);background:transparent;color:var(--accent);border-radius:2px;cursor:pointer;white-space:nowrap;}
.btn:hover{background:var(--accent-dim);}
.btn.primary{background:var(--accent);color:var(--navy-900);}
.btn.primary:hover{background:var(--sky-100);}
.btn.danger{border-color:var(--danger);color:var(--danger);}
.btn.danger:hover{background:var(--danger);color:var(--navy-900);}
.btn.ghost{border-color:var(--line);color:var(--muted);}
.btn.sm{padding:5px 10px;font-size:11px;}
.btn:disabled{opacity:.5;cursor:not-allowed;}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.chip{display:inline-block;font-size:10px;text-transform:uppercase;letter-spacing:.06em;font-weight:700;padding:3px 8px;border-radius:2px;background:var(--accent-dim);color:var(--accent);white-space:nowrap;}
.msg{padding:12px 14px;border-radius:2px;border:1px solid var(--line);background:var(--accent-dim);font-size:13px;margin-bottom:16px;line-height:1.5;}
.msg.error{border-color:var(--danger);color:var(--danger);background:rgba(255,107,94,.08);}
.msg.ok{border-color:var(--ok);color:var(--ok);background:rgba(95,212,160,.08);}
.center{text-align:center;}
.hidden{display:none!important;}
.spin{display:inline-block;width:16px;height:16px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:sp .8s linear infinite;vertical-align:middle;}
@keyframes sp{to{transform:rotate(360deg);}}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--accent);color:var(--navy-900);padding:10px 18px;border-radius:2px;font-size:13px;font-weight:600;z-index:200;box-shadow:0 6px 20px rgba(0,0,0,.4);max-width:90vw;}
.toast.bad{background:var(--danger);}
.modal-overlay{position:fixed;inset:0;background:rgba(15,5,25,.78);display:flex;align-items:flex-start;justify-content:center;z-index:100;padding:20px 12px;overflow-y:auto;}
.modal-box{background:var(--card);border:1px solid var(--line);border-radius:2px;width:100%;max-width:760px;margin:auto;}
.modal-box.sm{max-width:440px;}
.modal-header{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line);gap:10px;}
.modal-header h3{margin:0;}
.modal-close{background:none;border:none;color:var(--muted);font-size:24px;cursor:pointer;line-height:1;}
.modal-close:hover{color:var(--danger);}
.modal-body{padding:18px;}
.modal-foot{padding:12px 18px;border-top:1px solid var(--line);display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap;}
.success-icon{width:64px;height:64px;border-radius:50%;background:var(--accent);color:var(--navy-900);display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 14px;}
.app-id{font-family:'Courier New',monospace;font-size:20px;color:var(--accent);background:var(--input);border:1px dashed var(--accent);padding:10px 16px;display:inline-block;border-radius:2px;margin:8px 0;}
@media(max-width:640px){.grid2,.grid3{grid-template-columns:1fr;}h1{font-size:20px;}.wrap{padding:18px 12px 60px;}}

.tabs{display:flex;gap:8px;margin-bottom:20px;}
.tabs button{flex:1;font:600 13px 'Inter',sans-serif;padding:11px;border:1px solid var(--line);background:var(--card);color:var(--muted);border-radius:2px;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;}
.tabs button.active{background:var(--accent);border-color:var(--accent);color:var(--navy-900);}
.hgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px;}
.hcard{background:var(--card);border:1px solid var(--line);border-radius:2px;overflow:hidden;position:relative;}
.hcard img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#fff;}
.hcard .info{padding:12px;line-height:1.4;}
.hcard .hn{font:700 14px 'Space Grotesk',sans-serif;color:var(--sky-100);}
.hcard .hp{font-size:12px;color:var(--accent);font-weight:600;margin-top:3px;}
.hcard .hj{font-size:12px;color:var(--muted);margin-top:4px;}

</style>
<style>
  .nav{display:flex;gap:6px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:20px;padding-bottom:0;-webkit-overflow-scrolling:touch;}
  .nav button{background:none;border:none;border-bottom:3px solid transparent;color:var(--muted);font:600 13px 'Inter',sans-serif;padding:10px 14px;cursor:pointer;white-space:nowrap;text-transform:uppercase;letter-spacing:.06em;}
  .nav button.active{color:var(--accent);border-bottom-color:var(--accent);}
  .nav button:hover{color:var(--sky-100);}
  .session{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted);flex-wrap:wrap;}
  .role-chip{background:var(--gold);color:var(--navy-900);}
  .kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:20px;}
  .kpi{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:2px;padding:14px;cursor:default;}
  .kpi .num{font:700 26px 'Courier New',monospace;color:var(--accent);}
  .kpi .lab{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-top:2px;}
  .kpi.click{cursor:pointer;} .kpi.click:hover{background:var(--accent-dim);}
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:2px;}
  table{border-collapse:collapse;width:100%;font-size:13px;}
  th,td{padding:9px 10px;text-align:left;border-bottom:1px solid var(--line);vertical-align:middle;}
  th{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);background:#2A1248;white-space:nowrap;}
  tbody tr:hover{background:rgba(181,101,232,.06);}
  tr.clickrow{cursor:pointer;}
  td.mono,.mono{font-family:'Courier New',monospace;font-size:12px;}
  .filters{display:grid;grid-template-columns:2fr repeat(6,1fr);gap:10px;margin-bottom:14px;}
  .filters select,.filters input{padding:8px;font-size:13px;}
  .bar{height:10px;background:var(--input);border-radius:2px;overflow:hidden;min-width:60px;}
  .bar>i{display:block;height:100%;background:var(--accent);}
  .barrow{display:grid;grid-template-columns:minmax(90px,200px) 1fr 50px;gap:10px;align-items:center;margin-bottom:8px;font-size:13px;}
  .trend{display:flex;align-items:flex-end;gap:3px;height:120px;border-bottom:1px solid var(--line);}
  .trend i{flex:1;background:var(--accent);min-height:2px;border-radius:1px 1px 0 0;}
  .groups{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;}
  .group{background:var(--card);border:1px solid var(--line);border-radius:2px;}
  .group .gh{padding:12px 14px;border-bottom:1px solid var(--line);}
  .group .gl{max-height:340px;overflow-y:auto;padding:6px;}
  .gi{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:2px;font-size:13px;}
  .gi:hover{background:rgba(181,101,232,.08);}
  .gi .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;}
  .mini{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;font-size:11px;color:var(--muted);}
  .mini b{color:var(--ink);}
  .qcard{border:1px solid var(--line);background:#2A1248;border-radius:2px;padding:14px;margin-bottom:12px;}
  .qcard .qhead{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;}
  .orow{display:flex;gap:6px;margin-bottom:6px;}
  .sbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px;}
  .tl{border-left:2px solid var(--line);margin:8px 0 0 6px;padding-left:14px;}
  .tl .ev{margin-bottom:12px;font-size:13px;position:relative;}
  .tl .ev:before{content:'';position:absolute;left:-19px;top:5px;width:8px;height:8px;border-radius:50%;background:var(--accent);}
  .tl .ev .when{font:11px 'Courier New',monospace;color:var(--muted);}
  .ans{border-bottom:1px solid var(--line);padding:8px 0;}
  .ans .q{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);}
  .ans .a{white-space:pre-wrap;word-break:break-word;margin-top:2px;}
  .copybox{display:flex;gap:8px;}
  .copybox input{font-family:'Courier New',monospace;font-size:12px;}
  .swatch{width:34px;height:34px;padding:2px;}
  .stat-row{display:grid;grid-template-columns:1fr 1fr auto auto auto;gap:8px;margin-bottom:8px;align-items:center;}
  @media(max-width:900px){.filters{grid-template-columns:1fr 1fr;}.filters input{grid-column:1/-1;}.stat-row{grid-template-columns:1fr 60px;}}
</style>
</head>
<body>
<div class="wrap wide">
  <header class="top">
    <div class="brand-mark">
      <div class="scops-badge"><img src="data:image/png;base64," alt="SCOPS logo"></div>
      <div><p class="eyebrow">Recruitment Management</p><h1>SCOPS</h1></div>
    </div>
    <div class="session hidden" id="session">
      <span id="whoami"></span><span class="chip role-chip" id="roleChip"></span>
      <button class="btn ghost sm" id="refreshBtn">Refresh</button>
      <button class="btn ghost sm" id="logoutBtn">Sign out</button>
    </div>
  </header>

  <div id="loginView" class="hidden" style="max-width:420px;margin:40px auto;">
    <div class="panel">
      <h2>Staff sign in</h2>
      <div id="loginErr" class="msg error hidden"></div>
      <div class="field"><label for="liEmail">Email</label><input id="liEmail" type="email" autocomplete="username"></div>
      <div class="field"><label for="liPass">Password</label><input id="liPass" type="password" autocomplete="current-password"></div>
      <label class="opt"><input type="checkbox" id="liKeep"> Keep me signed in on this device</label>
      <button class="btn primary" id="loginBtn" style="width:100%;">Sign in</button>
      <p class="hint" style="margin-top:14px;">Authorized SCOPS administrators only. Accounts are created by an existing admin (Settings & Admins).</p>
    </div>
  </div>

  <div id="boot" class="panel center"><span class="spin"></span></div>
  <div id="app" class="hidden">
    <nav class="nav" id="nav"></nav>
    <main id="view"></main>
  </div>
</div>
<div id="modalRoot"></div>

<script>
/* SCOPS — recruitment shared helpers (Firebase REST + form renderer) */
(function(){
const FIREBASE_URL = 'https://falocons-recruitment-default-rtdb.firebaseio.com';
const FIREBASE_API_KEY = 'AIzaSyDGgO2XJZpiPO-1046kkLPIqM2CfEG0uXg'; // public web key (same as the main site); security comes from Database Rules
const FW = window.FW = {};

FW.esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
FW.$ = id => document.getElementById(id);
FW.uid = (n=6) => { const a='abcdefghjkmnpqrstuvwxyz23456789'; let s=''; const r=crypto.getRandomValues(new Uint8Array(n)); for(const x of r) s+=a[x%a.length]; return s; };
FW.TS = {'.sv':'timestamp'};

/* ---------- Auth (email/password, same Firebase project as the main site) ---------- */
let tok = null, refresh = null;
FW.auth = { uid: null, email: null };
const store = {
  area(){ try{ return localStorage.getItem('fw_keep')==='1' ? localStorage : sessionStorage; }catch(e){ return sessionStorage; } },
  get(k){ try{ return localStorage.getItem(k) || sessionStorage.getItem(k); }catch(e){ return null; } },
  set(k,v){ try{ this.area().setItem(k,v); }catch(e){} },
  del(k){ try{ localStorage.removeItem(k); sessionStorage.removeItem(k); }catch(e){} }
};
FW.keepSignedIn = on => { try{ on ? localStorage.setItem('fw_keep','1') : localStorage.removeItem('fw_keep'); }catch(e){} };
FW.keepPref = () => { try{ return localStorage.getItem('fw_keep')==='1'; }catch(e){ return false; } };
FW.signIn = async (email, password) => {
  try{
    const r = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${FIREBASE_API_KEY}`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password,returnSecureToken:true})});
    const d = await r.json();
    if(!r.ok) return {ok:false,error:(d.error&&d.error.message)||'error'};
    tok=d.idToken; refresh=d.refreshToken; FW.auth={uid:d.localId,email};
    store.set('fw_rt', refresh); store.set('fw_email', email);
    return {ok:true};
  }catch(e){ return {ok:false,error:'network'}; }
};
FW.restore = async () => {
  const rt = store.get('fw_rt'); if(!rt) return false;
  return doRefresh(rt);
};
async function doRefresh(rt){
  try{
    const r = await fetch(`https://securetoken.googleapis.com/v1/token?key=${FIREBASE_API_KEY}`, {method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:`grant_type=refresh_token&refresh_token=${encodeURIComponent(rt)}`});
    const d = await r.json(); if(!r.ok) return false;
    tok=d.id_token; refresh=d.refresh_token; FW.auth={uid:d.user_id,email:store.get('fw_email')||''};
    store.set('fw_rt', refresh); return true;
  }catch(e){ return false; }
}
FW.signOut = () => { tok=null; refresh=null; FW.auth={uid:null,email:null}; store.del('fw_rt'); store.del('fw_email'); };
/* Creates a Firebase Auth account WITHOUT replacing the current admin session */
FW.createAccount = async (email, password) => {
  try{
    const r = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=${FIREBASE_API_KEY}`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password,returnSecureToken:false})});
    const d = await r.json();
    if(!r.ok) return {ok:false,error:(d.error&&d.error.message)||'error'};
    return {ok:true,uid:d.localId};
  }catch(e){ return {ok:false,error:'network'}; }
};

/* ---------- Realtime Database REST ---------- */
FW.db = async (method, path, body, _retried) => {
  const url = `${FIREBASE_URL}/${path}.json${tok?`?auth=${tok}`:''}`;
  try{
    const r = await fetch(url, {method, headers: body!==undefined?{'Content-Type':'application/json'}:undefined, body: body!==undefined?JSON.stringify(body):undefined});
    if(r.status===401 && refresh && !_retried){ if(await doRefresh(refresh)) return FW.db(method,path,body,true); }
    let data=null; try{ data = await r.json(); }catch(e){}
    return {ok:r.ok, status:r.status, data};
  }catch(e){ return {ok:false,status:0,data:null}; }
};
FW.get = async p => (await FW.db('GET',p));
FW.patch = (p,b) => FW.db('PATCH',p,b);
FW.put = (p,b) => FW.db('PUT',p,b);
FW.del = p => FW.db('DELETE',p);

/* ---------- Form model ---------- */
FW.QTYPES = [
  ['short','Short answer'],['long','Long answer / essay'],['radio','Multiple choice (one answer)'],
  ['checkbox','Checkboxes (multiple answers)'],['dropdown','Dropdown'],['yesno','Yes / No']
];
FW.CORE = [['','— none —'],['name','Full name'],['phone','Phone'],['email','Email'],['university','University'],['year','Academic year'],['area','Residential area']];
FW.starterForm = () => {
  const q = (label,type,core,required,extra={}) => Object.assign({id:'q'+FW.uid(6),label,desc:'',type,core,required,options:[]},extra);
  const opts = a => a.map(x=>({id:'o'+FW.uid(4),label:x}));
  return [
    q('Full Name','short','name',true), q('Phone Number','short','phone',true), q('Email Address','short','email',true),
    q('University','short','university',true),
    q('Academic Year','dropdown','year',true,{options:opts(['1st year','2nd year','3rd year','4th year','5th year','Graduate'])}),
    q('Residential Area','short','area',true),
    q('Previous Experience','long','',false,{desc:'Tell us about any previous experience (optional).'}),
    q('Why do you want to join SCOPS?','long','',true)
  ];
};
FW.sortedQs = form => (form && form.questions ? Object.values(form.questions) : []).sort((a,b)=>(a.order||0)-(b.order||0));
FW.toFormObj = (arr, extra={}) => { const questions={}; arr.forEach((q,i)=>{ questions[q.id]=Object.assign({},q,{order:i,options:(q.options||[]).map(o=>({id:o.id,label:o.label}))}); }); return Object.assign({questions},extra); };

/* ---------- Renderer (used by public form AND admin preview) ---------- */
FW.renderQuestions = (qs, root) => {
  root.innerHTML = qs.map(q => {
    const id = 'f_'+q.id, name = 'q_'+q.id;
    let ctl = '';
    const opts = (q.options||[]);
    if(q.type==='short'){
      const t = q.core==='email'?'email':q.core==='phone'?'tel':'text';
      ctl = `<input dir="auto" id="${id}" name="${name}" type="${t}" maxlength="300" autocomplete="${q.core==='email'?'email':q.core==='phone'?'tel':q.core==='name'?'name':'off'}">`;
    }else if(q.type==='long'){
      ctl = `<textarea dir="auto" id="${id}" name="${name}" maxlength="4000"></textarea>`;
    }else if(q.type==='dropdown'){
      ctl = `<select id="${id}" name="${name}"><option value="">Select…</option>${opts.map(o=>`<option>${FW.esc(o.label)}</option>`).join('')}</select>`;
    }else if(q.type==='radio'||q.type==='yesno'){
      const list = q.type==='yesno'?[{label:'Yes'},{label:'No'}]:opts;
      ctl = list.map(o=>`<label class="opt"><input type="radio" name="${name}" value="${FW.esc(o.label)}"><span dir="auto">${FW.esc(o.label)}</span></label>`).join('');
    }else if(q.type==='checkbox'){
      ctl = opts.map(o=>`<label class="opt"><input type="checkbox" name="${name}" value="${FW.esc(o.label)}"><span dir="auto">${FW.esc(o.label)}</span></label>`).join('');
    }
    return `<div class="field" data-qid="${FW.esc(q.id)}"><label ${q.type==='short'||q.type==='long'||q.type==='dropdown'?`for="${id}"`:''} dir="auto">${FW.esc(q.label)}${q.required?'<span class="req" aria-label="required">*</span>':' <span class="hint" style="text-transform:none;letter-spacing:0;font-weight:400;">(optional)</span>'}</label>${q.desc?`<div class="desc" dir="auto">${FW.esc(q.desc)}</div>`:''}${ctl}<div class="err"></div></div>`;
  }).join('');
};
const norm = s => String(s||'').trim();
FW.normPhone = p => { const map={'٠':0,'١':1,'٢':2,'٣':3,'٤':4,'٥':5,'٦':6,'٧':7,'٨':8,'٩':9}; const d=String(p||'').replace(/[٠-٩]/g,c=>map[c]).replace(/\D/g,''); return d.slice(-10); };
FW.validEmail = e => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e);
/* returns {ok, answers, core, firstBad} and marks invalid fields */
FW.collect = (qs, root) => {
  const answers = {}, core = {}; let ok = true, firstBad = null;
  qs.forEach((q,i) => {
    const f = root.querySelector(`.field[data-qid="${q.id}"]`); if(!f) return;
    const name = 'q_'+q.id; let v = '';
    if(q.type==='checkbox') v = [...f.querySelectorAll(`input[name="${name}"]:checked`)].map(x=>x.value).join('\n');
    else if(q.type==='radio'||q.type==='yesno'){ const c=f.querySelector(`input[name="${name}"]:checked`); v=c?c.value:''; }
    else v = norm(f.querySelector('input,select,textarea').value);
    let msg='';
    if(q.required && !v) msg='This question is required.';
    else if(v && q.core==='email' && !FW.validEmail(v)) msg='Please enter a valid email address.';
    else if(v && q.core==='phone' && FW.normPhone(v).length<7) msg='Please enter a valid phone number.';
    f.classList.toggle('invalid', !!msg); f.querySelector('.err').textContent = msg;
    if(msg){ ok=false; if(!firstBad) firstBad=f; }
    answers[q.id] = {label:q.label, type:q.type, value:v, order:i};
    if(q.core && v) core[q.core]=v;
  });
  return {ok, answers, core, firstBad};
};
FW.hex = s => Array.from(new TextEncoder().encode(s)).map(b=>b.toString(16).padStart(2,'0')).join('');
FW.dupKeys = (core, fields) => {
  const k = {};
  if(fields.includes('phone') && core.phone){ const p=FW.normPhone(core.phone); if(p) k['p_'+p]=1; }
  if(fields.includes('email') && core.email) k['e_'+FW.hex(core.email.toLowerCase())]=1;
  if(fields.includes('name') && core.name) k['n_'+FW.hex(core.name.toLowerCase().replace(/\s+/g,' '))]=1;
  return Object.keys(k);
};
FW.toast = (msg, bad) => { const t=document.createElement('div'); t.className='toast'+(bad?' bad':''); t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(), 3200); };
FW.DEFAULT_STATUSES = [
  {key:'new',label:'New Application',color:'#B565E8'},
  {key:'review',label:'Under Review',color:'#B57BE0'},
  {key:'contacted',label:'Contacted',color:'#F8B048'},
  {key:'interview_scheduled',label:'Interview Scheduled',color:'#FF8FD0'},
  {key:'interviewed',label:'Interviewed',color:'#9830A0'},
  {key:'accepted',label:'Accepted',color:'#5FD4A0',final:true},
  {key:'rejected',label:'Rejected',color:'#FF6B5E',final:true},
  {key:'waitlisted',label:'Waitlisted',color:'#9AA7B5'}
];
FW.DEFAULT_SETTINGS = {open:false,title:'Join SCOPS',intro:'Fill in the form below to apply. It only takes a few minutes.',successMessage:'Thank you! Your application has been received. Our team will contact you soon.',closedMessage:'Applications are currently closed. Thank you for your interest in SCOPS.',dupFields:['phone','email']};

/* Applicant-facing wording per status (editable in admin > Settings). Rejection is deliberately gentle. */
FW.DEFAULT_PUB = {
  new:{pl:'Application received',pm:'Thank you for applying to SCOPS. We have received your application and our team will review it soon.'},
  review:{pl:'Under review',pm:'Thank you for your patience. Our team is currently reviewing your application carefully.'},
  contacted:{pl:"We've reached out",pm:'Thank you for your time. A member of our team has contacted you. Please check your phone and messages.'},
  interview_scheduled:{pl:'Interview scheduled',pm:'Great news — your interview has been scheduled. Our team will confirm the details with you directly.'},
  interviewed:{pl:'Interview completed',pm:"Thank you for the time and effort you put into your interview. We're finalizing our decisions and will update you soon."},
  accepted:{pl:'Accepted 🎉',pm:"Congratulations! We're delighted to welcome you to SCOPS. Our team will contact you shortly with the next steps."},
  rejected:{pl:'Application update',pm:"Thank you sincerely for your effort and your interest in SCOPS. After careful consideration, we're sorry to let you know that we are unable to move forward with your application at this time. We truly appreciate the time you invested and wish you every success — you are always welcome to apply again in the future."},
  waitlisted:{pl:'On the waitlist',pm:"Thank you for your effort. You are on our waitlist, and we will reach out if a spot becomes available. We appreciate your patience."}
};
FW.pubInfo = (statuses, key) => {
  const list = Array.isArray(statuses) ? statuses : Object.values(statuses||{});
  const s = list.find(x=>x && x.key===key) || {}; const d = FW.DEFAULT_PUB[key] || {};
  return { label: s.pl || d.pl || s.label || 'Application update', msg: s.pm || d.pm || 'Your application status has been updated. Thank you for your interest in SCOPS.', color: key==='rejected' ? '#B9A0D6' : (s.color || '#B565E8') };
};
})();

</script>
<script>
(function(){
const $ = FW.$, esc = FW.esc;
const S = { admins:{}, role:null, uid:null, name:'', settings:null, statuses:[], form:null, apps:{}, meta:{}, staff:{}, draft:null, dirty:false,
  workshops:{}, meta2:{}, sync:{}, slog:{}, view:'overview', F:{q:'',status:'',mod:'',uni:'',year:'',ws:'',assign:'',sort:'new',limit:100}, sel:new Set(), plan:null };
const isAdmin = () => S.role === 'admin';

/* ---------- helpers ---------- */
const today = () => { const d=new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; };
const fmtDT = t => t ? new Date(t).toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
const fmtD = t => t ? new Date(t).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—';
const fmtDay = s => s ? new Date(s+'T00:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—';
const arr = v => !v ? [] : Array.isArray(v) ? v.filter(Boolean) : Object.values(v);
const stOf = k => S.statuses.find(s=>s.key===k) || {key:k,label:k||'New Application',color:'#B565E8'};
const chip = k => { const s=stOf(k||'new'); return `<span class="chip" style="background:${esc(s.color)}22;color:${esc(s.color)};border:1px solid ${esc(s.color)}55">${esc(s.label)}</span>`; };
const isFinal = k => !!stOf(k||'new').final;
const mods = () => Object.entries(S.staff).map(([uid,v])=>({uid,name:v.name||v.email||uid,role:v.role})).sort((a,b)=>a.name.localeCompare(b.name));
const modName = uid => (S.staff[uid] && (S.staff[uid].name||S.staff[uid].email)) || (uid ? 'Former moderator' : '—');
const effAssigned = r => (r.m.assignedTo && S.staff[r.m.assignedTo]) ? r.m.assignedTo : '';
const rows = () => Object.values(S.apps).map(a => ({id:a.id, a, core:a.core||{}, answers:a.answers||{}, createdAt:a.createdAt, m:S.meta[a.id]||{}}));
const rowById = id => rows().find(r=>r.id===id);
/* ---------- workshops (names live in the database; ws1..ws6 are only stable slot IDs) ---------- */
const WS_IDS = ['ws1','ws2','ws3','ws4','ws5','ws6'];
const HB = 'highboard', HIST_IDS = [...WS_IDS, HB];   /* SCOPS History groups: High Board + the six workshops */
const wsIdOf = r => (r.a && r.a.workshopId) || '';
const wsCur = id => (S.workshops && S.workshops[id]) || {};
const wsTitle = id => String(wsCur(id).name||'').trim() || `Unnamed workshop (${id})`;
const wsLabel = r => { const id = wsIdOf(r); return id ? (String(wsCur(id).name||'').trim() || r.a.workshopName || id) : ''; };
const syncOf = id => S.sync[id] || null;
const syncState = id => { const x = syncOf(id); return x ? x.status : 'pending'; };
const SYNC_UI = {synced:['Synced','var(--ok)'],pending:['Pending','var(--warn)'],syncing:['Syncing','var(--warn)'],failed:['Failed','var(--danger)']};
const syncChip = id => { if(!isAdmin()) return ''; const [l,c] = SYNC_UI[syncState(id)] || SYNC_UI.pending; return `<span class="chip" style="background:${c}22;color:${c};border:1px solid ${c}55">${l}</span>`; };
function wsStats(wid){
  const R = rows().filter(r=>wsIdOf(r)===wid); const o = {total:R.length,synced:0,pending:0,failed:0};
  R.forEach(r=>{ const st = syncState(r.id); if(st==='synced') o.synced++; else if(st==='failed') o.failed++; else o.pending++; });
  return o;
}
const hist = m => Object.entries(m.history||{}).sort((a,b)=>a[0]<b[0]?-1:1).map(x=>x[1]);
const hk = () => String(Date.now()).padStart(14,'0')+FW.uid(3);
const csvCell = v => { let s=String(v==null?'':v); if(/^[=+\-@\t\r]/.test(s)) s="'"+s; return /[",\n\r]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s; };
const isOverdue = r => r.m.nextFollowUp && r.m.nextFollowUp < today() && !isFinal(r.m.status);
function modal(html, size){
  const el=document.createElement('div'); el.className='modal-overlay';
  el.innerHTML=`<div class="modal-box ${size||''}" role="dialog" aria-modal="true">${html}</div>`;
  el.addEventListener('mousedown',e=>{ if(e.target===el && !size) closeModal(el); });
  $('modalRoot').appendChild(el); return el;
}
function closeModal(el){ (el||$('modalRoot').lastElementChild)?.remove(); }
function confirmBox(title, text, okLabel, danger){
  return new Promise(res=>{
    const el = modal(`<div class="modal-header"><h3>${esc(title)}</h3></div><div class="modal-body"><p style="margin:0;line-height:1.6;font-size:14px;">${esc(text)}</p></div><div class="modal-foot"><button class="btn ghost" data-r="0">Cancel</button><button class="btn ${danger?'danger':'primary'}" data-r="1">${esc(okLabel||'Confirm')}</button></div>`,'sm');
    el.addEventListener('click',e=>{ const b=e.target.closest('[data-r]'); if(b){ closeModal(el); res(b.dataset.r==='1'); } });
  });
}
const btnBusy = (b,on,t) => { if(!b) return; b.disabled=on; if(t){ if(on){b.dataset.t=b.textContent; b.textContent=t;} else b.textContent=b.dataset.t||b.textContent; } };

/* ---------- boot / auth ---------- */
async function boot(){
  if(await FW.restore()) return enter();
  $('boot').classList.add('hidden'); $('loginView').classList.remove('hidden');
  try{ $('liEmail').value = localStorage.getItem('fw_email')||sessionStorage.getItem('fw_email')||''; $('liKeep').checked = FW.keepPref(); }catch(e){}
}
$('loginBtn').onclick = async () => {
  const b=$('loginBtn'); btnBusy(b,true,'Signing in…'); $('loginErr').classList.add('hidden');
  FW.keepSignedIn($('liKeep').checked);
  const r = await FW.signIn($('liEmail').value.trim(), $('liPass').value);
  btnBusy(b,false);
  if(!r.ok){ $('loginErr').textContent = r.error==='network'?'Network error. Please try again.':'Wrong email or password.'; $('loginErr').classList.remove('hidden'); return; }
  $('liPass').value=''; $('loginView').classList.add('hidden'); $('boot').classList.remove('hidden'); enter();
};
$('liPass').addEventListener('keydown',e=>{ if(e.key==='Enter') $('loginBtn').click(); });
$('logoutBtn').onclick = () => { FW.signOut(); location.reload(); };
$('refreshBtn').onclick = async () => { await loadAll(); render(); FW.toast('Data refreshed'); };

async function enter(){
  const uid = FW.auth.uid; S.uid = uid;
  const [adm, stf] = await Promise.all([FW.get('recruit/admins'), FW.get('recruit/staff/'+uid)]);
  if(adm.ok){ S.role='admin'; S.name = (stf.data&&stf.data.name) || FW.auth.email || 'Admin'; }
  else{
    FW.signOut();
    $('boot').classList.add('hidden'); $('loginView').classList.remove('hidden');
    $('loginErr').textContent='This dashboard is restricted to SCOPS administrators only.'; $('loginErr').classList.remove('hidden'); return;
  }
  await loadAll();
  $('boot').classList.add('hidden'); $('app').classList.remove('hidden'); $('session').classList.remove('hidden');
  $('whoami').textContent = S.name; $('roleChip').textContent = S.role;
  S.view = 'overview'; render();
}

async function loadAll(){
  const s = await FW.get('recruit/settings');
  S.settings = Object.assign({}, FW.DEFAULT_SETTINGS, s.data||{});
  S.settings.dupFields = arr(S.settings.dupFields);
  S.statuses = arr(S.settings.statuses); if(!S.statuses.length) S.statuses = FW.DEFAULT_STATUSES.slice();
  S.workshops = (await FW.get('recruit/workshops')).data || {};
  if(isAdmin()){
    const [a,m,st,pf,df,ad] = await Promise.all([FW.get('recruit/applications'),FW.get('recruit/meta'),FW.get('recruit/staff'),FW.get('recruit/form/published'),FW.get('recruit/form/draft'),FW.get('recruit/admins')]);
    S.admins = ad.data||{};
    S.apps = a.data||{}; S.meta = m.data||{}; S.staff = st.data||{}; S.form = pf.data;
    S.hist = (await FW.get('recruit/history')).data || {};
    const [wc, sy, sl] = await Promise.all([FW.get('recruit/syncMeta'), FW.get('recruit/sync'), FW.get('recruit/syncLog')]);
    S.meta2 = wc.data || {}; S.sync = sy.data || {}; S.slog = sl.data || {};
    const missing = WS_IDS.filter(id=>!S.workshops[id]);   /* first run: create the six empty, inactive slots */
    if(missing.length){ const seed = {}; missing.forEach(id=>seed[id] = {name:'',active:false,order:WS_IDS.indexOf(id)}); const sr = await FW.patch('recruit/workshops', seed); if(sr.ok) Object.assign(S.workshops, seed); }
    if(!S.draft || !S.dirty) S.draft = df.data ? FW.sortedQs(df.data) : (pf.data ? FW.sortedQs(pf.data) : FW.starterForm());
  }else{
    const [as, me] = await Promise.all([FW.get('recruit/assign/'+S.uid), FW.get('recruit/staff/'+S.uid)]);
    const ids = Object.keys(as.data||{});
    S.staff = {}; S.staff[S.uid] = me.data||{name:S.name};
    S.apps = {}; S.meta = {};
    await Promise.all(ids.map(async id => {
      const [a,m] = await Promise.all([FW.get('recruit/applications/'+id), FW.get('recruit/meta/'+id)]);
      if(a.ok && a.data) S.apps[id]=a.data; if(m.ok && m.data) S.meta[id]=m.data;
    }));
  }
  S.sel = new Set([...S.sel].filter(id=>S.apps[id]));
}

/* ---------- writes ---------- */
async function writeMeta(ids, fields, histEntry){
  // fields: object applied to every id ; histEntry: function(row)->{type,text}|null
  const body = {}; const now = Date.now();
  ids.forEach(id => {
    const r = rowById(id); const old = r.m.assignedTo;
    Object.entries(fields).forEach(([k,v]) => { body[`meta/${id}/${k}`] = v; });
    body[`meta/${id}/updatedAt`] = now;
    if(fields.status) body[`public/${id}`] = {s:fields.status, at:FW.TS};
    if('assignedTo' in fields){
      if(old && old!==fields.assignedTo) body[`assign/${old}/${id}`] = null;
      if(fields.assignedTo) body[`assign/${fields.assignedTo}/${id}`] = true;
      if(fields.followOwner===undefined && (!r.m.followOwner || r.m.followOwner===old)) body[`meta/${id}/followOwner`] = fields.assignedTo || null;
    }
    const h = histEntry && histEntry(r);
    if(h) body[`meta/${id}/history/${hk()}`] = {at:FW.TS, by:S.name, type:h.type, text:h.text};
  });
  const res = await FW.patch('recruit', body);
  if(!res.ok){ FW.toast('Save failed — check your permissions/connection', true); return false; }
  // mirror locally
  ids.forEach(id => {
    const m = S.meta[id] = S.meta[id] || {};
    Object.entries(fields).forEach(([k,v]) => { if(v===null) delete m[k]; else m[k]=v; });
    if('assignedTo' in fields && body[`meta/${id}/followOwner`]!==undefined){ if(body[`meta/${id}/followOwner`]===null) delete m.followOwner; else m.followOwner = body[`meta/${id}/followOwner`]; }
    m.updatedAt = now;
    const k = Object.keys(body).find(x=>x.startsWith(`meta/${id}/history/`));
    if(k){ m.history = m.history||{}; m.history[k.split('/').pop()] = Object.assign({}, body[k], {at:now}); }
  });
  return true;
}
const assignIds = (ids, uid) => writeMeta(ids, {assignedTo: uid||null}, r => ({type:'assign', text: uid ? `Assigned to ${modName(uid)}` + (effAssigned(r)&&effAssigned(r)!==uid?` (from ${modName(effAssigned(r))})`:'') : 'Unassigned'}));

/* ---------- views ---------- */
const TABS = () => isAdmin()
  ? [['overview','Overview'],['applicants','Applicants'],['workshops','Workshops'],['followups','Follow-ups'],['builder','Form Builder'],['reports','Reports'],['history','SCOPS History'],['settings','Settings & Admins']]
  : [['overview','My Overview'],['applicants','My Applicants'],['followups','Follow-ups']];
function render(){
  $('nav').innerHTML = TABS().map(([k,l])=>`<button data-act="tab" data-k="${k}" class="${S.view===k?'active':''}">${l}</button>`).join('');
  const v = {overview,applicants,workshops:workshopsView,followups,builder,reports,history:historyView,settings:settingsView}[S.view];
  $('view').innerHTML = ''; v($('view'));
}

/* Overview */
function overview(el){
  const R = rows(), total = R.length;
  const byStatus = {}; R.forEach(r=>{ const k=r.m.status||'new'; byStatus[k]=(byStatus[k]||0)+1; });
  const unassigned = R.filter(r=>!effAssigned(r)).length;
  const overdue = R.filter(isOverdue).length;
  const notContacted = R.filter(r=>!r.m.lastContact && !isFinal(r.m.status)).length;
  let h = `<div class="kpis">
    <div class="kpi click" data-act="goto" data-k="applicants"><div class="num">${total}</div><div class="lab">Total applications</div></div>
    ${S.statuses.map(s=>`<div class="kpi click" style="border-left-color:${esc(s.color)}" data-act="goto" data-k="applicants" data-status="${esc(s.key)}"><div class="num" style="color:${esc(s.color)}">${byStatus[s.key]||0}</div><div class="lab">${esc(s.label)}</div></div>`).join('')}
    <div class="kpi click" style="border-left-color:var(--danger)" data-act="goto" data-k="followups"><div class="num" style="color:var(--danger)">${overdue}</div><div class="lab">Overdue follow-ups</div></div>
    <div class="kpi click" style="border-left-color:var(--warn)" data-act="goto" data-k="followups"><div class="num" style="color:var(--warn)">${notContacted}</div><div class="lab">Not contacted yet</div></div>
  </div>`;
  if(isAdmin()){
    const failedN = Object.values(S.sync).filter(x=>x && x.status==='failed').length;
    const wmax = Math.max(1,...WS_IDS.map(id=>wsStats(id).total));
    h += `<div class="panel"><h2>Workshops</h2>${failedN?`<div class="msg error">${failedN} Sheets sync operation(s) failed. <a href="#" data-act="goto" data-k="workshops" style="color:inherit;text-decoration:underline">Review in Workshops</a></div>`:''}${WS_IDS.filter(id=>String(wsCur(id).name||'').trim()).map(id=>barRow(wsTitle(id),wsStats(id).total,wmax)).join('') || '<p class="hint">No workshops named yet. Set them up in the Workshops tab.</p>'}</div>`;
  }
  h += `<div class="panel"><h2>Submissions — last 30 days</h2>${trend(R)}</div>`;
  const hasLinkInfo = isAdmin() && !S.settings.open ? `<div class="msg">Applications are currently <b>closed</b>. Open them from Settings & Admins.</div>` : '';
  el.innerHTML = hasLinkInfo + h;
}
const barRow = (l,n,max) => `<div class="barrow"><span>${esc(l)}</span><div class="bar"><i style="width:${Math.round(n/max*100)}%"></i></div><b class="mono">${n}</b></div>`;
function trend(R){
  const days=[]; for(let i=29;i>=0;i--){ const d=new Date(); d.setDate(d.getDate()-i); days.push(`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`); }
  const c={}; R.forEach(r=>{ if(!r.createdAt) return; const d=new Date(r.createdAt); const k=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; c[k]=(c[k]||0)+1; });
  const max=Math.max(1,...days.map(d=>c[d]||0));
  return `<div class="trend">${days.map(d=>`<i title="${d}: ${c[d]||0}" style="height:${Math.round((c[d]||0)/max*100)}%"></i>`).join('')}</div><div class="row hint" style="justify-content:space-between;margin-top:4px;"><span>${days[0]}</span><span>peak: ${max}/day</span><span>${days[29]}</span></div>`;
}

/* Applicants */
function filtered(){
  const F=S.F, q=F.q.trim().toLowerCase(), qd=FW.normPhone(F.q);
  let R = rows().filter(r=>{
    if(q){ const hay=`${r.core.name||''} ${r.core.university||''} ${r.id}`.toLowerCase(); const ph = qd.length>=3 && FW.normPhone(r.core.phone).includes(qd);
      if(!hay.includes(q) && !ph && !String(r.core.phone||'').includes(q)) return false; }
    if(F.status && (r.m.status||'new')!==F.status) return false;
    if(F.uni && (r.core.university||'')!==F.uni) return false;
    if(F.year && (r.core.year||'')!==F.year) return false;
    if(F.ws && wsIdOf(r)!==F.ws) return false;
    return true;
  });
  const s=F.sort, by = {
    new:(a,b)=>(b.createdAt||0)-(a.createdAt||0), old:(a,b)=>(a.createdAt||0)-(b.createdAt||0),
    name:(a,b)=>(a.core.name||'').localeCompare(b.core.name||''), status:(a,b)=>S.statuses.findIndex(x=>x.key===(a.m.status||'new'))-S.statuses.findIndex(x=>x.key===(b.m.status||'new')),
    follow:(a,b)=>(a.m.nextFollowUp||'9999').localeCompare(b.m.nextFollowUp||'9999'), contact:(a,b)=>(a.m.lastContact||0)-(b.m.lastContact||0)
  };
  return R.sort(by[s]||by.new);
}
function applicants(el){
  const R = rows(), F=S.F;
  const uniq = k => [...new Set(R.map(r=>r.core[k]).filter(Boolean))].sort();
  const opt = (list,sel,all) => `<option value="">${all}</option>`+list.map(x=>`<option value="${esc(x[0])}" ${x[0]===sel?'selected':''}>${esc(x[1])}</option>`).join('');
  const list = filtered();
  el.innerHTML = `<div class="panel">
    <div class="filters">
      <input id="fq" placeholder="Search name, phone, university or ID…" value="${esc(F.q)}" dir="auto">
      <select data-f="status">${opt(S.statuses.map(s=>[s.key,s.label]),F.status,'All statuses')}</select>
      <select data-f="uni">${opt(uniq('university').map(x=>[x,x]),F.uni,'All universities')}</select>
      <select data-f="year">${opt(uniq('year').map(x=>[x,x]),F.year,'All years')}</select>
      <select data-f="ws">${opt(WS_IDS.filter(id=>String(wsCur(id).name||'').trim()).map(id=>[id,wsTitle(id)]),F.ws,'All workshops')}</select>
    </div>
    <div class="sbar">
      <select data-f="sort" style="width:auto;"><option value="new">Newest first</option><option value="old">Oldest first</option><option value="name">Name A–Z</option><option value="status">Status</option><option value="follow">Next follow-up</option><option value="contact">Last contact (oldest)</option></select>
      <span class="hint">${list.length} of ${R.length} applicants</span>
      <span style="flex:1"></span>
      ${isAdmin()?`<button class="btn sm" data-act="export">Export CSV</button>`:''}
    </div>
    <div class="tablewrap"><table><thead><tr>
      <th>ID</th><th>Name</th><th>Phone</th><th>University</th><th>Year</th><th>Workshop</th>${isAdmin()?'<th>Sheets</th>':''}<th>Status</th><th>Last contact</th><th>Next follow-up</th><th>Submitted</th></tr></thead><tbody>
      ${list.slice(0,F.limit).map(r=>`<tr class="clickrow" data-act="open" data-id="${esc(r.id)}">
        <td class="mono">${esc(r.id)}</td><td dir="auto"><b>${esc(r.core.name||'—')}</b></td><td class="mono">${esc(r.core.phone||'—')}</td><td dir="auto">${esc(r.core.university||'—')}</td><td>${esc(r.core.year||'—')}</td>
        <td dir="auto">${esc(wsLabel(r)||'—')}</td>${isAdmin()?`<td>${wsIdOf(r)?syncChip(r.id):'—'}</td>`:''}<td>${chip(r.m.status)}</td>
        <td class="mono">${fmtD(r.m.lastContact)}</td><td class="mono" style="${isOverdue(r)?'color:var(--danger);font-weight:700':''}">${fmtDay(r.m.nextFollowUp)}</td><td class="mono">${fmtD(r.createdAt)}</td></tr>`).join('') || `<tr><td colspan="12" class="center hint" style="padding:30px;">No applicants match.</td></tr>`}
      </tbody></table></div>
    ${list.length>F.limit?`<div class="center" style="margin-top:12px;"><button class="btn" data-act="more">Show more (${list.length-F.limit} left)</button></div>`:''}
  </div>`;
  el.querySelector('[data-f="sort"]').value = F.sort;
}

/* Profile */
function openProfile(id){
  const r = rowById(id); if(!r) return;
  const m=r.m, staffOpts = (sel,none) => `<option value="">${none}</option>`+mods().map(x=>`<option value="${esc(x.uid)}" ${x.uid===sel?'selected':''}>${esc(x.name)}</option>`).join('');
  const ans = Object.values(r.answers).sort((a,b)=>(a.order||0)-(b.order||0));
  const H = hist(m).slice().reverse();
  const el = modal(`<div class="modal-header"><div><div class="mono" style="color:var(--accent)">${esc(r.id)}</div><h3 dir="auto">${esc(r.core.name||'Applicant')}</h3></div><button class="modal-close" data-act="closeM" aria-label="Close">×</button></div>
  <div class="modal-body">
    <div class="row" style="margin-bottom:14px;">${chip(m.status)} <span class="hint">Submitted ${fmtDT(r.createdAt)}</span></div>
    <div class="row" style="margin-bottom:14px;"><span class="hint">Workshop:</span> <b dir="auto">${esc(wsLabel(r)||'—')}</b> ${wsIdOf(r)?syncChip(r.id):''}${isAdmin()&&wsIdOf(r)&&syncState(r.id)!=='synced'?`<button class="btn sm" data-act="retryOne" data-id="${esc(r.id)}">Retry Sheets sync</button>`:''}${isAdmin()&&syncOf(r.id)&&syncOf(r.id).lastError?`<span class="hint">${esc(syncOf(r.id).lastError.message||'')}</span>`:''}</div>
    <h2>Recruitment tracking</h2>
    <div class="grid2">
      <div class="field"><label>Status</label><select id="pStatus">${S.statuses.map(s=>`<option value="${esc(s.key)}" ${s.key===(m.status||'new')?'selected':''}>${esc(s.label)}</option>`).join('')}</select></div>
      <div class="field"><label>Next follow-up</label><input type="date" id="pNext" value="${esc(m.nextFollowUp||'')}"></div>
      <div class="field"><label>Last contact</label><input disabled value="${fmtDT(m.lastContact)}"></div>
    </div>
    <div class="field"><label>Private notes (internal)</label><textarea id="pNotes" dir="auto">${esc(m.notes||'')}</textarea></div>
    <button class="btn primary" data-act="saveProfile" data-id="${esc(id)}">Save changes</button>

    <h2 style="margin-top:26px;">Log an interaction</h2>
    <div class="panel" style="background:#2A1248;margin-bottom:0;">
      <div class="grid2">
        <div class="field"><label>Type</label><select id="lType"><option value="call">Call</option><option value="message">Message</option><option value="interview">Interview</option><option value="followup">Follow-up</option><option value="note">Note</option></select></div>
        <div class="field"><label>Update status (optional)</label><select id="lStatus"><option value="">Keep current</option>${S.statuses.map(s=>`<option value="${esc(s.key)}">${esc(s.label)}</option>`).join('')}</select></div>
        <div class="field"><label>Schedule next follow-up (optional)</label><input type="date" id="lNext"></div>
      </div>
      <div class="field"><label>What happened / next steps</label><textarea id="lText" dir="auto" style="min-height:70px"></textarea></div>
      <button class="btn" data-act="logInteraction" data-id="${esc(id)}">Record interaction</button>
    </div>

    <h2 style="margin-top:26px;">Applicant info ${isAdmin()?`<button class="btn sm ghost" data-act="editCore" data-id="${esc(id)}" style="margin-left:8px;">Edit</button>`:''}</h2>
    <div id="coreBox">${coreView(r)}</div>

    <h2 style="margin-top:26px;">Submitted answers</h2>
    ${ans.map(a=>`<div class="ans"><div class="q" dir="auto">${esc(a.label)}</div><div class="a" dir="auto">${a.value?esc(a.value):'<span class="hint">— not answered —</span>'}</div></div>`).join('')}

    <h2 style="margin-top:26px;">History</h2>
    <div class="tl">${H.map(e=>`<div class="ev"><div class="when">${fmtDT(e.at)} · ${esc(e.by||'')} · ${esc(e.type)}</div><div dir="auto" style="white-space:pre-wrap">${esc(e.text)}</div></div>`).join('') || '<div class="hint">No activity yet.</div>'}
      <div class="ev"><div class="when">${fmtDT(r.createdAt)}</div><div>Application submitted</div></div></div>
  </div>`);
  el.dataset.id = id;
}
const coreView = r => `<div class="grid2">${FW.CORE.filter(c=>c[0]).map(([k,l])=>`<div class="field" style="margin-bottom:8px;"><label>${l}</label><div dir="auto">${esc(r.core[k]||'—')}</div></div>`).join('')}</div>`;

/* Workshop Management */
function workshopsView(el){
  const failed = Object.entries(S.sync).filter(([id,x])=>x && x.status==='failed').sort((a,b)=>(b[1].lastAttemptAt||0)-(a[1].lastAttemptAt||0));
  const logs = Object.entries(S.slog).sort((a,b)=>a[0]<b[0]?1:-1).slice(0,15);
  const last = S.meta2 && S.meta2.lastRun, stale = !last || Date.now()-last > 10*60000;
  const card = (id,n) => {
    const w = wsCur(id), st = wsStats(id);
    return `<div class="qcard" data-ws="${id}"><div class="qhead"><b class="mono">Slot ${n+1} · ID ${id}</b>
      <span class="chip" style="${w.active?'background:#5FD4A022;color:var(--ok)':'background:#FF6B5E22;color:var(--danger)'}">${w.active?'Active':'Inactive'}</span></div>
      <div class="grid2"><div class="field"><label>Workshop name</label><input data-w="name" value="${esc(w.name||'')}" dir="auto" maxlength="80" placeholder="Not set"></div>
      <div class="field"><label>Visibility in the application form</label><select data-w="active"><option value="1" ${w.active?'selected':''}>Active — applicants can choose it</option><option value="0" ${!w.active?'selected':''}>Inactive — hidden</option></select></div></div>
      <div class="mini" style="margin:0 0 12px"><span>Applicants <b>${st.total}</b></span><span>In sheet <b style="color:var(--ok)">${st.synced}</b></span><span>Waiting <b style="color:var(--warn)">${st.pending}</b></span><span>Failed <b style="color:var(--danger)">${st.failed}</b></span></div>
      <div class="row"><button class="btn primary sm" data-act="wsSave">Save name & status</button>${st.failed?`<button class="btn sm danger" data-act="wsRetry">Retry ${st.failed} failed</button>`:''}</div></div>`;
  };
  el.innerHTML = `<div class="msg">Workshop names are controlled only from here. Each workshop keeps a permanent internal ID, so renaming never breaks anything. All applications go to <b>one Google Sheet</b>; the <b>Selected Workshop</b> column tells you which workshop each member chose (filter or sort on it).</div>
    <div class="msg ${stale?'error':'ok'}">Sheet sync: ${last?`last run ${fmtDT(last)}`:'has not run yet'}${stale?' — check that the Apps Script trigger is set up (see README).':''}${S.meta2&&S.meta2.sheet?` · <a href="${esc(S.meta2.sheet)}" target="_blank" rel="noopener" style="color:inherit">Open the sheet</a>`:''}</div>
    ${WS_IDS.map(card).join('')}
    <div class="panel"><div class="row" style="justify-content:space-between"><h2 style="margin:0">Failed sheet synchronizations <span class="chip">${failed.length}</span></h2>${failed.length?'<button class="btn sm danger" data-act="retryAll">Retry all failed</button>':''}</div>
      ${failed.length?`<div class="tablewrap" style="margin-top:12px"><table><thead><tr><th>Application</th><th>Workshop</th><th>Attempts</th><th>Reason</th><th>Last attempt</th><th></th></tr></thead><tbody>${failed.map(([id,x])=>`<tr><td class="mono">${esc(id)}</td><td dir="auto">${esc(x.workshopId?wsTitle(x.workshopId):'—')}</td><td class="mono">${x.attempts||0}</td><td>${esc((x.lastError&&x.lastError.message)||'')}</td><td class="mono">${fmtDT(x.lastAttemptAt)}</td><td><button class="btn sm" data-act="retryOne" data-id="${esc(id)}">Retry</button></td></tr>`).join('')}</tbody></table></div>`:'<p class="hint" style="margin:10px 0 0">No failed synchronizations.</p>'}</div>
    <div class="panel"><h2>Recent sync log</h2>${logs.length?`<div class="tablewrap"><table><tbody>${logs.map(([k,x])=>`<tr><td class="mono">${fmtDT(x.at)}</td><td class="mono">${esc(x.appId||'')}</td><td>${esc(x.workshopId?wsTitle(x.workshopId):'')}</td><td class="mono">${esc(x.code||'')}</td><td>${esc(x.message||'')}</td></tr>`).join('')}</tbody></table></div>`:'<p class="hint">Nothing logged.</p>'}</div>`;
}

/* Follow-ups */
function followups(el){
  const R = rows(), t = today();
  const open = R.filter(r=>!isFinal(r.m.status));
  const sets = [
    ['Overdue follow-ups', open.filter(r=>r.m.nextFollowUp && r.m.nextFollowUp<t).sort((a,b)=>a.m.nextFollowUp.localeCompare(b.m.nextFollowUp)), 'var(--danger)'],
    ['Due today', open.filter(r=>r.m.nextFollowUp===t), 'var(--warn)'],
    ['Upcoming', open.filter(r=>r.m.nextFollowUp>t).sort((a,b)=>a.m.nextFollowUp.localeCompare(b.m.nextFollowUp)), 'var(--accent)'],
    ['Not contacted yet', open.filter(r=>!r.m.lastContact).sort((a,b)=>(a.createdAt||0)-(b.createdAt||0)), 'var(--warn)'],
    ['Awaiting interview decision', R.filter(r=>r.m.status==='interviewed'), 'var(--teal-400)']
  ];
  el.innerHTML = `<div class="msg">Reminders are shown here in the dashboard only. No messages are sent automatically — contact applicants yourself, then record the interaction.</div>` +
    sets.map(([t_,list,c])=>`<div class="panel" style="border-left:3px solid ${c}"><h2>${t_} <span class="chip">${list.length}</span></h2>${list.length?`<div class="tablewrap"><table><tbody>${list.slice(0,100).map(r=>`<tr class="clickrow" data-act="open" data-id="${esc(r.id)}"><td dir="auto"><b>${esc(r.core.name||r.id)}</b><div class="mono hint">${esc(r.id)}</div></td><td class="mono">${esc(r.core.phone||'')}</td><td>${chip(r.m.status)}</td><td class="mono">${r.m.nextFollowUp?fmtDay(r.m.nextFollowUp):'—'}</td></tr>`).join('')}</tbody></table></div>`:'<p class="hint" style="margin:0">Nothing here.</p>'}</div>`).join('');
}

/* Reports */
function reports(el){
  const R = rows(); const total=R.length||1;
  const group = (keyFn,labelFn,src) => { const c={}; (src||R).forEach(r=>{ const k=keyFn(r); c[k]=(c[k]||0)+1; }); return Object.entries(c).sort((a,b)=>b[1]-a[1]).map(([k,n])=>[labelFn?labelFn(k):k,n]); };
  const bars = list => { const max=Math.max(1,...list.map(x=>x[1])); return list.map(([l,n])=>barRow(l||'—',n,max)).join('') || '<p class="hint">No data yet.</p>'; };
  const t = today();
  const wait = R.filter(r=>!isFinal(r.m.status) && (!r.m.lastContact || (r.m.nextFollowUp && r.m.nextFollowUp<=t)));
  // funnel
  const reached = k => R.filter(r=>(r.m.status||'new')===k || hist(r.m).some(h=>h.type==='status' && h.text.endsWith('→ '+stOf(k).label))).length;
  const chain = ['new','contacted','interview_scheduled','interviewed','accepted'].filter(k=>S.statuses.some(s=>s.key===k));
  const fun = chain.map((k,i)=>{ const n = k==='new'?R.length:reached(k); const prev = i? (chain[i-1]==='new'?R.length:reached(chain[i-1])) : n; return [stOf(k).label,n, i&&prev?Math.round(n/prev*100)+'% of previous':'']; });
  el.innerHTML = `<div class="sbar"><button class="btn" data-act="export">Export all data (CSV)</button></div>
  <div class="grid2"><div class="panel"><h2>By university</h2>${bars(group(r=>r.core.university||'—'))}</div>
  <div class="panel"><h2>By academic year</h2>${bars(group(r=>r.core.year||'—'))}</div>
  <div class="panel"><h2>By workshop</h2>${bars(group(r=>wsLabel(r)||'—'))}</div>
  <div class="panel"><h2>By status</h2>${bars(group(r=>r.m.status||'new',k=>stOf(k).label))}</div>
  <div class="panel"><h2>Awaiting follow-up</h2><div class="kpi" style="margin-bottom:10px"><div class="num">${wait.length}</div><div class="lab">Not contacted or follow-up due</div></div></div></div>
  <div class="panel"><h2>Submissions over time (30 days)</h2>${trend(R)}</div>
  <div class="panel"><h2>Conversion between stages</h2>${fun.map(f=>`<div class="barrow" style="grid-template-columns:minmax(120px,200px) 1fr 140px"><span>${esc(f[0])}</span><div class="bar"><i style="width:${Math.round(f[1]/total*100)}%"></i></div><b class="mono">${f[1]} <span class="hint">${f[2]}</span></b></div>`).join('')}<p class="hint">A stage counts applicants who are currently in it or passed through it (based on recorded status changes).</p></div>`;
}
function exportCsv(){
  if(!isAdmin()){ FW.toast('Export is restricted to administrators', true); return; }
  const R = filteredForExport();
  const qmap = {}; R.forEach(r=>Object.entries(r.answers).forEach(([q,a])=>{ if(q==='__workshop') return; if(!qmap[q]) qmap[q]={label:a.label,order:a.order||0}; }));
  const qids = Object.keys(qmap).sort((a,b)=>qmap[a].order-qmap[b].order);
  const head = ['Application ID','Submitted','Name','Phone','Email','University','Year','Area','Status','Last contact','Next follow-up','Notes','Workshop','Sheets sync',...qids.map(q=>qmap[q].label)];
  const lines = [head.map(csvCell).join(',')];
  R.forEach(r=>lines.push([r.id,r.createdAt?new Date(r.createdAt).toISOString():'',r.core.name,r.core.phone,r.core.email,r.core.university,r.core.year,r.core.area,stOf(r.m.status).label,r.m.lastContact?new Date(r.m.lastContact).toISOString():'',r.m.nextFollowUp||'',r.m.notes||'',wsLabel(r),wsIdOf(r)?syncState(r.id):'',...qids.map(q=>r.answers[q]?r.answers[q].value.replace(/\n/g,'; '):'')].map(csvCell).join(',')));
  const blob = new Blob(['﻿'+lines.join('\r\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`scops-applicants-${today()}.csv`; document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),2000);
  FW.toast(`Exported ${R.length} applicants`);
}
const filteredForExport = () => S.view==='applicants' ? filtered() : rows();

/* Form builder */
function builder(el){
  const D = S.draft, pub = S.form;
  const link = new URL('./', location.href).href;
  el.innerHTML = `<div class="panel"><div class="row" style="justify-content:space-between;">
      <div><b>Application form</b><div class="hint">Published version: ${pub?('v'+(pub.version||1)+' · '+fmtDT(pub.publishedAt)):'not published yet'} · Applications are <b style="color:${S.settings.open?'var(--ok)':'var(--danger)'}">${S.settings.open?'OPEN':'CLOSED'}</b></div></div>
      <div class="row"><button class="btn sm" data-act="toggleOpen">${S.settings.open?'Close applications':'Open applications'}</button></div></div>
    ${S.dirty?'<div class="msg" style="margin:12px 0 0">You have unsaved changes.</div>':''}</div>
    <div id="qlist">${D.map((q,i)=>qCard(q,i,D.length)).join('')}</div>
    <div class="row" style="margin-bottom:20px;"><button class="btn" data-act="addQ">+ Add question</button></div>
    <div class="panel"><div class="row"><button class="btn" data-act="saveDraft">Save draft</button><button class="btn" data-act="previewForm">Preview form</button><button class="btn primary" data-act="publishForm">Publish form</button></div>
    <p class="hint">Publishing makes the current draft visible to applicants. Previously submitted answers are never changed or deleted — each answer keeps the question text it was submitted with.</p></div>`;
}
function qCard(q,i,n){
  const choice = ['radio','checkbox','dropdown'].includes(q.type);
  return `<div class="qcard" data-i="${i}"><div class="qhead"><b class="mono">Q${i+1}</b><div class="row">
    <button class="btn sm ghost" data-act="qUp" data-i="${i}" ${i===0?'disabled':''} aria-label="Move up">↑</button><button class="btn sm ghost" data-act="qDown" data-i="${i}" ${i===n-1?'disabled':''} aria-label="Move down">↓</button><button class="btn sm danger" data-act="qDel" data-i="${i}">Delete</button></div></div>
    <div class="field"><label>Question</label><input data-q="label" data-i="${i}" value="${esc(q.label)}" dir="auto" maxlength="300"></div>
    <div class="field"><label>Description (optional)</label><input data-q="desc" data-i="${i}" value="${esc(q.desc||'')}" dir="auto" maxlength="500"></div>
    <div class="grid3"><div class="field"><label>Type</label><select data-q="type" data-i="${i}">${FW.QTYPES.map(t=>`<option value="${t[0]}" ${t[0]===q.type?'selected':''}>${t[1]}</option>`).join('')}</select></div>
    <div class="field"><label>Required?</label><select data-q="required" data-i="${i}"><option value="1" ${q.required?'selected':''}>Required</option><option value="0" ${!q.required?'selected':''}>Optional</option></select></div>
    <div class="field"><label>Maps to profile field</label><select data-q="core" data-i="${i}">${FW.CORE.map(c=>`<option value="${c[0]}" ${c[0]===(q.core||'')?'selected':''}>${c[1]}</option>`).join('')}</select></div></div>
    ${choice?`<label>Answer options</label>${(q.options||[]).map((o,j)=>`<div class="orow"><input data-o="${j}" data-i="${i}" value="${esc(o.label)}" dir="auto" maxlength="200"><button class="btn sm ghost" data-act="oUp" data-i="${i}" data-j="${j}" ${j===0?'disabled':''}>↑</button><button class="btn sm ghost" data-act="oDown" data-i="${i}" data-j="${j}" ${j===(q.options.length-1)?'disabled':''}>↓</button><button class="btn sm danger" data-act="oDel" data-i="${i}" data-j="${j}">×</button></div>`).join('')}<button class="btn sm" data-act="oAdd" data-i="${i}">+ Add option</button>`:''}</div>`;
}
function draftObj(){ return FW.toFormObj(S.draft,{updatedAt:Date.now()}); }
function validateDraft(){
  const D=S.draft; if(!D.length) return 'Add at least one question.';
  for(let i=0;i<D.length;i++){ const q=D[i];
    if(!q.label.trim()) return `Question ${i+1} has no title.`;
    if(['radio','checkbox','dropdown'].includes(q.type)){ const o=(q.options||[]).filter(x=>x.label.trim()); if(o.length<2) return `Question ${i+1} needs at least two options.`; }
  }
  return null;
}
function previewForm(){
  const el = modal(`<div class="modal-header"><h3>Preview — exactly as applicants see it</h3><button class="modal-close" data-act="closeM">×</button></div><div class="modal-body"><h2 dir="auto">${esc(S.settings.title)}</h2><p class="hint" dir="auto">${esc(S.settings.intro)}</p><div id="pvFields"></div><button class="btn primary" style="width:100%" id="pvSubmit">Submit application (preview only)</button></div>`);
  FW.renderQuestions(S.draft.map(q=>Object.assign({},q,{options:(q.options||[]).filter(o=>o.label.trim())})), el.querySelector('#pvFields'));
  el.querySelector('#pvSubmit').onclick = () => { const r=FW.collect(S.draft,el.querySelector('#pvFields')); FW.toast(r.ok?'Validation passed — nothing was saved':'Please fix the highlighted fields', !r.ok); };
}


/* SCOPS History (ex-moderators shown on the public page) */
const histList = () => Object.entries(S.hist||{}).map(([id,h])=>Object.assign({id},h)).sort((a,b)=>(a.order||0)-(b.order||0));
function compressImage(file, maxBytes){
  return new Promise((resolve,reject)=>{
    const img=new Image(), url=URL.createObjectURL(file);
    img.onload=()=>{ URL.revokeObjectURL(url); let w=img.naturalWidth,h=img.naturalHeight; const m=700; if(Math.max(w,h)>m){ const k=m/Math.max(w,h); w=Math.round(w*k); h=Math.round(h*k); }
      const c=document.createElement('canvas'); c.width=w; c.height=h; c.getContext('2d').drawImage(img,0,0,w,h);
      let q=.85, out=c.toDataURL('image/jpeg',q); while(out.length>maxBytes && q>.4){ q-=.1; out=c.toDataURL('image/jpeg',q); } resolve(out); };
    img.onerror=()=>{ URL.revokeObjectURL(url); reject(new Error('bad image')); }; img.src=url;
  });
}
const wsOpts = sel => `<option value="">— Choose workshop or High Board —</option><option value="${HB}" ${sel===HB?'selected':''}>High Board</option>`+WS_IDS.map(id=>`<option value="${id}" ${sel===id?'selected':''}>${esc(wsTitle(id))}</option>`).join('');
function historyView(el){
  const all = histList();
  const card = (h,i,L)=>`<div class="hcard"><img src="${esc(h.photo)}" alt=""><div class="info"><div class="hn" dir="auto">${esc(h.name)}</div><div class="hp" dir="auto">${esc(h.position)}</div>${h.job?`<div class="hj" dir="auto">${esc(h.job)}</div>`:''}
    <div class="row" style="margin-top:10px;gap:6px;"><button class="btn sm ghost" data-act="hUp" data-id="${esc(h.id)}" ${i===0?'disabled':''}>↑</button><button class="btn sm ghost" data-act="hDown" data-id="${esc(h.id)}" ${i===L.length-1?'disabled':''}>↓</button><button class="btn sm" data-act="hEdit" data-id="${esc(h.id)}">Edit</button><button class="btn sm danger" data-act="hDel" data-id="${esc(h.id)}">×</button></div></div></div>`;
  const section = (title,L,note)=>`<div class="panel"><h2>${title} <span class="hint" style="font-weight:400;">(${L.length})</span></h2>${note?`<p class="hint">${note}</p>`:''}<div class="hgrid">${L.map((h,i)=>card(h,i,L)).join('')||'<p class="hint">No one added yet.</p>'}</div></div>`;
  const unassigned = all.filter(h=>!HIST_IDS.includes(h.workshopId));
  el.innerHTML = `<div class="panel"><h2>Add ex-moderator</h2>
    <p class="hint">Members first see “High Board” and the workshop names in the “SCOPS History” tab; clicking one reveals the people you add to it here. For High Board, type any position you like (President, Vice President, …). The current job is optional.</p>
    <div class="grid2"><div class="field"><label>Group (High Board or workshop)</label><select id="hWs">${wsOpts('')}</select></div>
    <div class="field"><label>Photo</label><input type="file" id="hFile" accept="image/*"></div>
    <div class="field"><label>Name</label><input id="hName" dir="auto" maxlength="100"></div>
    <div class="field"><label>Position in SCOPS</label><input id="hPos" dir="auto" maxlength="100" placeholder="e.g. President / Vice President / Head of Sales"></div>
    <div class="field"><label>Current job (optional)</label><input id="hJob" dir="auto" maxlength="150"></div></div>
    <button class="btn primary" data-act="hAdd">Add to SCOPS History</button></div>
  ${unassigned.length?section('Not assigned to a workshop',unassigned,'These are hidden from members until you assign a workshop (Edit → Workshop).'):''}
  ${section('High Board',all.filter(h=>h.workshopId===HB),'Shown first in the “SCOPS History” tab. Write each person’s position freely (President, Vice President, …).')}
  ${WS_IDS.map(id=>section(esc(wsTitle(id)),all.filter(h=>h.workshopId===id),'')).join('')}`;
}

/* Settings & team */
const adminList = () => Object.keys(S.admins||{}).filter(u=>S.admins[u]).map(uid=>{ const v=S.staff[uid]||{}; const me=uid===S.uid; return {uid,name:v.name||(me?S.name:'')||v.email||uid,email:v.email||(me?FW.auth.email:'')||''}; }).sort((a,b)=>a.name.localeCompare(b.name));
function settingsView(el){
  const s=S.settings, link=new URL('./', location.href).href;
  el.innerHTML = `
  <div class="panel"><h2>Public application link</h2>
    <div class="copybox"><input readonly id="pubLink" value="${esc(link)}"><button class="btn" data-act="copyLink">Copy</button></div>
    <p class="hint" style="margin-top:10px;">Share this link with applicants (WhatsApp, social media, QR code). It shows only the published form — no applicant data is ever exposed. Make sure applications are <b>open</b> below.</p>
    <div class="row" style="margin-top:8px;"><span class="chip" style="background:${s.open?'#5FD4A022':'#FF6B5E22'};color:${s.open?'var(--ok)':'var(--danger)'}">${s.open?'Applications open':'Applications closed'}</span><button class="btn sm" data-act="toggleOpen">${s.open?'Close applications':'Open applications'}</button></div></div>
  <div class="panel"><h2>Messages & duplicate detection</h2>
    <div class="field"><label>Form title</label><input id="sTitle" value="${esc(s.title)}" dir="auto"></div>
    <div class="field"><label>Intro text</label><textarea id="sIntro" dir="auto" style="min-height:60px">${esc(s.intro)}</textarea></div>
    <div class="field"><label>Confirmation message (after submit)</label><textarea id="sSuccess" dir="auto" style="min-height:60px">${esc(s.successMessage)}</textarea></div>
    <div class="field"><label>Message shown when applications are closed</label><textarea id="sClosed" dir="auto" style="min-height:60px">${esc(s.closedMessage)}</textarea></div>
    <label>Block a submission if an earlier one has the same…</label>
    <div class="row" style="margin:8px 0 14px;">${[['phone','Phone number'],['email','Email'],['name','Full name']].map(([k,l])=>`<label class="opt" style="margin:0"><input type="checkbox" class="dup" value="${k}" ${s.dupFields.includes(k)?'checked':''}>${l}</label>`).join('')}</div>
    <p class="hint">Duplicate checks apply to new submissions only and need the question to be mapped to a profile field in the Form Builder.</p>
    <button class="btn primary" data-act="saveSettings">Save settings</button></div>
  <div class="panel"><h2>Recruitment statuses</h2><div id="stList">${S.statuses.map((x,i)=>{ const pi=FW.pubInfo(S.statuses,x.key); return `<div class="qcard stat-row" data-i="${i}" style="display:block;"><div class="row" style="flex-wrap:nowrap;margin-bottom:8px;"><input data-s="label" value="${esc(x.label)}" dir="auto" maxlength="40"><input type="color" class="swatch" data-s="color" value="${esc(x.color)}"><label class="opt" style="margin:0;padding:5px 8px;" title="Final stages don't need follow-ups"><input type="checkbox" data-s="final" ${x.final?'checked':''}>Final</label><button class="btn sm ghost" data-act="stUp" data-i="${i}">↑</button><button class="btn sm danger" data-act="stDel" data-i="${i}">×</button></div>
      <label>What the applicant sees — title</label><input data-s="pl" value="${esc(pi.label)}" dir="auto" maxlength="60" style="margin-bottom:8px;">
      <label>What the applicant sees — message</label><textarea data-s="pm" dir="auto" style="min-height:70px">${esc(pi.msg)}</textarea></div>`; }).join('')}</div>
    <div class="row"><button class="btn sm" data-act="stAdd">+ Add status</button><button class="btn primary" data-act="saveStatuses">Save statuses</button></div>
    <p class="hint">Applicants can track their stage with their application ID. The title and message above are what they see for each status.</p><p class="hint">Status keys never change, so renaming a status keeps all existing applicants in it. "Accepted"/"Rejected" keep their reports by key.</p></div>
  <div class="panel"><h2>Admins</h2>
    <div class="tablewrap"><table><thead><tr><th>Name</th><th>Email</th><th></th></tr></thead><tbody>${adminList().map(a=>`<tr><td>${esc(a.name)}${a.uid===S.uid?' <span class="chip">you</span>':''}</td><td class="mono">${esc(a.email)}</td><td>${a.uid===S.uid?'':`<button class="btn sm danger" data-act="rmAdmin" data-uid="${esc(a.uid)}">Remove</button>`}</td></tr>`).join('')||'<tr><td colspan="3" class="hint center" style="padding:20px">No admins.</td></tr>'}</tbody></table></div>
    <h3 style="margin-top:18px;">Add admin</h3>
    <div class="grid3"><div class="field"><label>Name</label><input id="nmName" dir="auto"></div><div class="field"><label>Email</label><input id="nmEmail" type="email"></div><div class="field"><label>Temporary password (min 6)</label><input id="nmPass" type="text" autocomplete="off"></div></div>
    <div class="row"><button class="btn primary" data-act="addAdmin">Create admin</button></div>
    <p class="hint">Every admin has the same full access as you (applicants, workshops, form builder, reports, history, settings and adding or removing other admins). Share the email and password privately.</p></div>`;
}

/* ---------- events ---------- */
document.addEventListener('click', async e => {
  if(e.target.closest('[data-stop]')) return;
  const t = e.target.closest('[data-act]'); if(!t) return;
  const act=t.dataset.act, id=t.dataset.id, i=+t.dataset.i, j=+t.dataset.j;
  if(t.matches('input[type=checkbox]')) { /* handled in change */ return; }
  switch(act){
    case 'tab': S.view=t.dataset.k; render(); break;
    case 'goto': S.view=t.dataset.k; if(t.dataset.k==='applicants'){ S.F=Object.assign({},S.F,{q:'',status:t.dataset.status||'',assign:t.dataset.assign||'',mod:'',uni:'',year:'',ws:t.dataset.ws||''}); } render(); break;
    case 'open': openProfile(id); break;
    case 'closeM': closeModal(t.closest('.modal-overlay')); break;
    case 'more': S.F.limit+=100; render(); break;
    case 'clearSel': S.sel.clear(); render(); break;
    case 'export': exportCsv(); break;
    case 'bulkAssign': {
      const v=$('bulkMod').value; if(!v) return FW.toast('Choose a moderator first', true);
      if(!S.sel.size) return FW.toast('Select applicants first', true);
      const uid = v==='__none'?null:v;
      if(!await confirmBox('Confirm assignment', `${uid?`Assign ${S.sel.size} applicant(s) to ${modName(uid)}?`:`Remove the moderator from ${S.sel.size} applicant(s)?`}`, 'Confirm')) return;
      if(await assignIds([...S.sel], uid)){ S.sel.clear(); FW.toast('Assignment saved'); render(); } break; }
    case 'saveProfile': {
      const r=rowById(id), m=r.m, ns=$('pStatus').value, notes=$('pNotes').value, next=$('pNext').value;
      const fields={}; const log=[];
      if(ns!==(m.status||'new')){ fields.status=ns; log.push(`Status: ${stOf(m.status).label} → ${stOf(ns).label}`); }
      if(notes!==(m.notes||'')){ fields.notes=notes; log.push('Notes updated'); }
      if(next!==(m.nextFollowUp||'')){ fields.nextFollowUp=next||null; log.push(next?`Next follow-up set to ${next}`:'Next follow-up cleared'); }
      if(!Object.keys(fields).length) return FW.toast('No changes to save');
      const stLog = fields.status?[{type:'status',text:log.shift()}]:[]; // keep status entry typed for funnel
      const rest = log.length?[{type:'update',text:log.join('\n')}]:[]; const entries=[...stLog,...rest];
      // write meta fields with first history entry, then others
      const ok = await writeMeta([id], fields, ()=>entries[0]||null);
      if(ok && entries[1]){ await writeMeta([id], {}, ()=>entries[1]); }
      if(ok){ FW.toast('Saved'); closeModal(t.closest('.modal-overlay')); render(); } break; }
    case 'logInteraction': {
      const text=$('lText').value.trim(), type=$('lType').value, ns=$('lStatus').value, next=$('lNext').value;
      if(!text) return FW.toast('Describe the interaction first', true);
      const r=rowById(id), fields={ lastContact:Date.now() };
      if(type==='note') delete fields.lastContact;
      if(ns && ns!==(r.m.status||'new')) fields.status=ns;
      if(next) fields.nextFollowUp=next;
      const first = {type, text};
      const ok = await writeMeta([id], fields, ()=>first);
      if(ok && fields.status) await writeMeta([id], {}, ()=>({type:'status',text:`Status: ${stOf(r.m.status).label} → ${stOf(ns).label}`}));
      if(ok){ FW.toast('Interaction recorded'); closeModal(t.closest('.modal-overlay')); render(); openProfile(id); } break; }
    case 'editCore': {
      const r=rowById(id);
      $('coreBox').innerHTML = `<div class="grid2">${FW.CORE.filter(c=>c[0]).map(([k,l])=>`<div class="field" style="margin-bottom:8px;"><label>${l}</label><input data-core="${k}" value="${esc(r.core[k]||'')}" dir="auto" maxlength="300"></div>`).join('')}</div><button class="btn primary" data-act="saveCore" data-id="${esc(id)}">Save applicant info</button>`; break; }
    case 'saveCore': {
      const core={}; document.querySelectorAll('[data-core]').forEach(x=>{ if(x.value.trim()) core[x.dataset.core]=x.value.trim(); });
      if(!core.name) return FW.toast('Name is required', true);
      const res = await FW.put(`recruit/applications/${id}/core`, core);
      if(!res.ok) return FW.toast('Save failed', true);
      if(S.apps[id].workshopId){ await FW.patch('recruit/sync/'+id, {status:'pending', attempts:0}); if(S.sync[id]) S.sync[id].status='pending'; }
      S.apps[id].core = core; await writeMeta([id], {}, ()=>({type:'edit',text:'Applicant information edited'})); FW.toast('Saved'); render(); openProfile(id); break; }
    case 'toggleOpen': {
      const next=!S.settings.open;
      if(next && !(S.form && S.form.questions)) return FW.toast('Publish the form first', true);
      if(!await confirmBox(next?'Open applications':'Close applications', next?'Applicants will be able to submit using the public link.':'The public link will show the "applications closed" message.', next?'Open':'Close', !next)) return;
      const r=await FW.put('recruit/settings/open', next); if(r.ok){ S.settings.open=next; FW.toast(next?'Applications are open':'Applications closed'); render(); } else FW.toast('Failed',true); break; }
    case 'copyLink': { try{ await navigator.clipboard.writeText($('pubLink').value); FW.toast('Link copied'); }catch(err){ $('pubLink').select(); FW.toast('Press Ctrl+C to copy'); } break; }
    case 'saveSettings': {
      const body = { title:$('sTitle').value.trim()||FW.DEFAULT_SETTINGS.title, intro:$('sIntro').value.trim(), successMessage:$('sSuccess').value.trim(), closedMessage:$('sClosed').value.trim(), dupFields:[...document.querySelectorAll('.dup:checked')].map(x=>x.value) };
      const r=await FW.patch('recruit/settings', body); if(r.ok){ Object.assign(S.settings,body); FW.toast('Settings saved'); } else FW.toast('Save failed',true); break; }
    case 'stAdd': syncStatuses(); S.statuses.push({key:'s'+FW.uid(5),label:'New status',color:'#B565E8',pl:'Application update',pm:'Your application status has been updated. Thank you for your interest in SCOPS.'}); render(); break;
    case 'stUp': syncStatuses(); if(i>0){ [S.statuses[i-1],S.statuses[i]]=[S.statuses[i],S.statuses[i-1]]; } render(); break;
    case 'stDel': {
      syncStatuses(); const k=S.statuses[i].key, used=rows().filter(r=>(r.m.status||'new')===k).length;
      if(used) return FW.toast(`${used} applicant(s) are in this status — move them first`, true);
      if(S.statuses.length<=1) return FW.toast('Keep at least one status', true);
      S.statuses.splice(i,1); render(); break; }
    case 'saveStatuses': {
      syncStatuses(); if(S.statuses.some(s=>!s.label.trim())) return FW.toast('Every status needs a name', true);
      const r=await FW.put('recruit/settings/statuses', S.statuses.map(s=>({key:s.key,label:s.label.trim(),color:s.color,final:!!s.final,pl:(s.pl||'').trim(),pm:(s.pm||'').trim()}))); FW.toast(r.ok?'Statuses saved':'Save failed',!r.ok); break; }
    case 'addAdmin': {
      const name=$('nmName').value.trim(), email=$('nmEmail').value.trim(), pass=$('nmPass').value;
      if(!name||!email||pass.length<6) return FW.toast('Enter name, email and a password of 6+ characters', true);
      btnBusy(t,true,'Creating…');
      const c = await FW.createAccount(email, pass);
      if(!c.ok){ btnBusy(t,false); return FW.toast(c.error==='EMAIL_EXISTS'?'That email already has an account':'Could not create the account ('+c.error+')', true); }
      const r1 = await FW.put('recruit/admins/'+c.uid, true);
      const r2 = r1.ok ? await FW.put('recruit/staff/'+c.uid, {name,email,role:'admin'}) : r1; btnBusy(t,false);
      if(r1.ok&&r2.ok){ S.admins[c.uid]=true; S.staff[c.uid]={name,email,role:'admin'}; FW.toast('Admin created'); render(); } else FW.toast('Account created but permissions failed',true); break; }
    case 'rmAdmin': {
      const uid=t.dataset.uid; if(uid===S.uid) return FW.toast('You cannot remove yourself', true);
      const a=adminList().find(x=>x.uid===uid)||{name:uid};
      if(!await confirmBox('Remove admin', `${a.name} will lose access immediately. (Also disable the account in Firebase Authentication if it should not exist anymore.)`, 'Remove', true)) return;
      const r1=await FW.del('recruit/admins/'+uid), r2=await FW.del('recruit/staff/'+uid);
      if(r1.ok&&r2.ok){ delete S.admins[uid]; delete S.staff[uid]; FW.toast('Admin removed'); render(); } else FW.toast('Failed',true); break; }
    case 'hAdd': {
      const f=$('hFile').files[0], name=$('hName').value.trim(), pos=$('hPos').value.trim(), job=$('hJob').value.trim(), wsId=$('hWs').value;
      if(!f||!name||!pos) return FW.toast('Photo, name and position are required', true);
      if(!HIST_IDS.includes(wsId)) return FW.toast('Choose a workshop or High Board', true);
      btnBusy(t,true,'Saving…');
      let photo; try{ photo=await compressImage(f,150000); }catch(err){ btnBusy(t,false); return FW.toast('Could not read that image', true); }
      const L=histList(), id='h'+FW.uid(8), rec={photo,name,position:pos,workshopId:wsId,order:(L.length?L[L.length-1].order+1:0)}; if(job) rec.job=job;
      const r=await FW.put('recruit/history/'+id, rec); btnBusy(t,false);
      if(r.ok){ S.hist[id]=rec; FW.toast('Added'); render(); } else FW.toast('Save failed — check the database rules', true); break; }
    case 'hDel': if(await confirmBox('Remove from SCOPS History','Remove this person from the public page?','Remove',true)){ const r=await FW.del('recruit/history/'+id); if(r.ok){ delete S.hist[id]; render(); } else FW.toast('Failed',true); } break;
    case 'hUp': case 'hDown': {
      const cur=S.hist[id], L=histList().filter(x=>(HIST_IDS.includes(x.workshopId)?x.workshopId:'')===(HIST_IDS.includes(cur.workshopId)?cur.workshopId:'')), k=L.findIndex(x=>x.id===id), o=act==='hUp'?k-1:k+1; if(o<0||o>=L.length) break;
      const a=L[k], b=L[o]; const r=await FW.patch('recruit/history',{[a.id+'/order']:b.order,[b.id+'/order']:a.order});
      if(r.ok){ S.hist[a.id].order=b.order; S.hist[b.id].order=a.order; render(); } else FW.toast('Failed',true); break; }
    case 'hEdit': {
      const h=S.hist[id];
      const el=modal(`<div class="modal-header"><h3>Edit</h3><button class="modal-close" data-act="closeM">×</button></div><div class="modal-body">
        <div class="field"><label>Group (High Board or workshop)</label><select id="eWs">${wsOpts(h.workshopId)}</select></div>
        <div class="field"><label>Name</label><input id="eName" value="${esc(h.name)}" dir="auto" maxlength="100"></div>
        <div class="field"><label>Position in SCOPS</label><input id="ePos" value="${esc(h.position)}" dir="auto" maxlength="100"></div>
        <div class="field"><label>Current job (optional)</label><input id="eJob" value="${esc(h.job||'')}" dir="auto" maxlength="150"></div>
        <div class="field"><label>Replace photo (optional)</label><input type="file" id="eFile" accept="image/*"></div></div>
        <div class="modal-foot"><button class="btn primary" id="eSave">Save</button></div>`,'sm');
      el.querySelector('#eSave').onclick=async()=>{
        const name=$('eName').value.trim(), pos=$('ePos').value.trim(), job=$('eJob').value.trim(), wsId=$('eWs').value; if(!name||!pos) return FW.toast('Name and position are required', true);
        if(!HIST_IDS.includes(wsId)) return FW.toast('Choose a workshop or High Board', true);
        const rec=Object.assign({},h,{name,position:pos,workshopId:wsId}); delete rec.id; if(job) rec.job=job; else delete rec.job;
        const f=$('eFile').files[0]; if(f){ try{ rec.photo=await compressImage(f,150000); }catch(err){ return FW.toast('Could not read that image', true); } }
        const r=await FW.put('recruit/history/'+id, rec); if(r.ok){ S.hist[id]=rec; closeModal(el); render(); FW.toast('Saved'); } else FW.toast('Save failed', true); };
      break; }
    case 'wsSave': {
      const cardEl = t.closest('[data-ws]'), wid = cardEl.dataset.ws;
      const name = cardEl.querySelector('[data-w=name]').value.trim().replace(/\s+/g,' '), active = cardEl.querySelector('[data-w=active]').value==='1';
      if(active && !name) return FW.toast('Give the workshop a name before activating it', true);
      if(name && WS_IDS.some(o=>o!==wid && String(wsCur(o).name||'').trim().toLowerCase()===name.toLowerCase())) return FW.toast('Another workshop already uses that name', true);
      const rec = {name, active, order: WS_IDS.indexOf(wid)};
      const r = await FW.patch('recruit/workshops/'+wid, rec);
      if(r.ok){ S.workshops[wid] = Object.assign({}, S.workshops[wid], rec); FW.toast('Workshop saved'); render(); } else FW.toast('Save failed — check the database rules', true); break; }
    case 'wsRetry': case 'retryOne': case 'retryAll': {
      const wid = act==='wsRetry' ? t.closest('[data-ws]').dataset.ws : null;
      const ids = act==='retryOne' ? [id] : Object.entries(S.sync).filter(([k,x])=>x && x.status==='failed' && (act==='retryAll' || x.workshopId===wid)).map(([k])=>k);
      if(!ids.length) return FW.toast('Nothing to retry');
      const body = {}; ids.forEach(k=>{ body[k+'/status']='pending'; body[k+'/attempts']=0; body[k+'/nextRetryAt']=null; });
      btnBusy(t,true,'Queuing…'); const r = await FW.patch('recruit/sync', body); btnBusy(t,false);
      if(!r.ok) return FW.toast('Could not queue the retry', true);
      ids.forEach(k=>{ if(S.sync[k]){ S.sync[k].status='pending'; S.sync[k].attempts=0; } });
      FW.toast(`${ids.length} queued — they reach the sheet within about a minute`);
      const ov = t.closest('.modal-overlay'); render(); if(ov){ closeModal(ov); openProfile(id); } break; }
    case 'addQ': S.draft.push({id:'q'+FW.uid(6),label:'',desc:'',type:'short',core:'',required:false,options:[]}); S.dirty=true; render(); break;
    case 'qUp': if(i>0){ [S.draft[i-1],S.draft[i]]=[S.draft[i],S.draft[i-1]]; S.dirty=true; render(); } break;
    case 'qDown': if(i<S.draft.length-1){ [S.draft[i+1],S.draft[i]]=[S.draft[i],S.draft[i+1]]; S.dirty=true; render(); } break;
    case 'qDel': if(await confirmBox('Delete question', 'Remove this question from the form? Answers already submitted are kept.', 'Delete', true)){ S.draft.splice(i,1); S.dirty=true; render(); } break;
    case 'oAdd': S.draft[i].options=S.draft[i].options||[]; S.draft[i].options.push({id:'o'+FW.uid(4),label:''}); S.dirty=true; render(); break;
    case 'oDel': S.draft[i].options.splice(j,1); S.dirty=true; render(); break;
    case 'oUp': if(j>0){ const o=S.draft[i].options; [o[j-1],o[j]]=[o[j],o[j-1]]; S.dirty=true; render(); } break;
    case 'oDown': { const o=S.draft[i].options; if(j<o.length-1){ [o[j+1],o[j]]=[o[j],o[j+1]]; S.dirty=true; render(); } break; }
    case 'previewForm': previewForm(); break;
    case 'saveDraft': { const r=await FW.put('recruit/form/draft', draftObj()); if(r.ok){ S.dirty=false; FW.toast('Draft saved'); render(); } else FW.toast('Save failed',true); break; }
    case 'publishForm': {
      const err=validateDraft(); if(err) return FW.toast(err,true);
      if(!await confirmBox('Publish form', 'Applicants will immediately see this version. Existing applications are not affected.', 'Publish')) return;
      S.draft.forEach(q=>{ q.options=(q.options||[]).filter(o=>o.label.trim()); });
      const v=((S.form&&S.form.version)||0)+1, obj=draftObj(); obj.version=v; obj.publishedAt=Date.now();
      const r=await FW.patch('recruit', {'form/published':obj,['form/archive/'+v]:obj,'form/draft':obj});
      if(r.ok){ S.form=obj; S.dirty=false; FW.toast('Form published (v'+v+')'); render(); } else FW.toast('Publish failed',true); break; }
  }
});
function syncStatuses(){ document.querySelectorAll('#stList .stat-row').forEach(row=>{ const i=+row.dataset.i, s=S.statuses[i]; if(!s) return; s.label=row.querySelector('[data-s=label]').value; s.color=row.querySelector('[data-s=color]').value; s.final=row.querySelector('[data-s=final]').checked; s.pl=row.querySelector('[data-s=pl]').value; s.pm=row.querySelector('[data-s=pm]').value; }); }

document.addEventListener('change', e => {
  const t=e.target;
  if(t.dataset.act==='sel'){ t.checked?S.sel.add(t.dataset.id):S.sel.delete(t.dataset.id); const c=$('selCount'); if(c) c.textContent=S.sel.size+' selected'; return; }
  if(t.dataset.act==='selAll'){ filtered().slice(0,S.F.limit).forEach(r=>t.checked?S.sel.add(r.id):S.sel.delete(r.id)); render(); return; }
  if(t.dataset.f){ S.F[t.dataset.f]=t.value; S.F.limit=100; render(); return; }
  if(t.dataset.q){ const q=S.draft[+t.dataset.i], k=t.dataset.q; if(k==='required') q.required=t.value==='1'; else q[k]=t.value;
    if(k==='type'){ if(['radio','checkbox','dropdown'].includes(t.value) && !(q.options||[]).length) q.options=[{id:'o'+FW.uid(4),label:''},{id:'o'+FW.uid(4),label:''}]; S.dirty=true; render(); } else S.dirty=true; }
});
document.addEventListener('input', e => {
  const t=e.target;
  if(t.id==='fq'){ S.F.q=t.value; S.F.limit=100; clearTimeout(window.__ft); window.__ft=setTimeout(()=>{ const pos=t.selectionStart; render(); const n=$('fq'); if(n){ n.focus(); n.setSelectionRange(pos,pos); } },250); return; }
  if(t.dataset.q && t.tagName==='INPUT'){ S.draft[+t.dataset.i][t.dataset.q]=t.value; S.dirty=true; }
  if(t.dataset.o!==undefined && t.dataset.i!==undefined){ S.draft[+t.dataset.i].options[+t.dataset.o].label=t.value; S.dirty=true; }
  if(t.classList.contains('gsearch')){ const q=t.value.toLowerCase(); t.closest('.group').querySelectorAll('.gi').forEach(g=>g.style.display=g.dataset.s.includes(q)?'':'none'); }
});
window.addEventListener('beforeunload', e => { if(S.dirty){ e.preventDefault(); e.returnValue=''; } });
boot();
})();
</script>
</body>
</html>
